{
  "name": "amap-api",
  "version": "1.0.0",
  "description": "API for Routine Info Workflow",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "func start",
    "test": "node --test dist/tests/auth.test.js",
    "check": "npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.5.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.8",
    "@types/node": "20.x",
    "typescript": "^5.8.3"
  }
}
